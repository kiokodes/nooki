{
  "name": "temp-app",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "predev": "npm run build:geo",
    "dev": "vite",
    "prebuild": "npm run build:geo",
    "build": "npm run check:env && tsc -b && vite build",
    "build:geo": "node scripts/build-geo-data.mjs",
    "check:env": "node scripts/check-env.mjs",
    "lint": "oxlint",
    "test": "node --test tests/*.test.mjs",
    "test:browser": "playwright test",
    "preview": "vite preview",
    "check:functions": "tsc -p tsconfig.functions.json",
    "build:word-puzzles": "node scripts/build-word-puzzles.mjs",
    "upload:word-puzzles": "node scripts/upload-word-puzzles.mjs"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.117.3",
    "epubjs": "^0.3.93",
    "lucide-react": "^1.57.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-pdf": "^11.0.0"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.10",
    "@playwright/test": "^1.64.1",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@types/web-push": "^3.6.4",
    "@vitejs/plugin-react": "^6.1.1",
    "country-state-city": "^3.2.1",
    "jsdom": "^30.1.2",
    "oxlint": "^1.81.0",
    "subtlex-word-frequencies": "^2.0.0",
    "typescript": "~6.0.2",
    "tz-lookup": "^6.1.25",
    "vite": "^8.3.0",
    "word-list-json": "^0.2.0"
  }
}
