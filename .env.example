# Supabase Configuration for Nooki (GitHub + Vercel + Supabase)

# 1. In your local development:
# Copy this file to .env.local and fill in your Supabase project credentials.

# 2. In your Vercel Dashboard:
# Project Settings -> Environment Variables -> Add these two keys:
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key
